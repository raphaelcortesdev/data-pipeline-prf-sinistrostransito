# ============================================================================
# VARIÁVEIS DE AMBIENTE - PRF PIPELINE
# ============================================================================
# INSTRUÇÕES: 
# 1. Faça uma cópia deste arquivo na mesma pasta.
# 2. Renomeie a cópia para ".env" (sem as aspas e sem nome antes do ponto).
# ============================================================================

# ============================================================================
# 1. CONFIGURAÇÕES DO BANCO DE DADOS (POSTGRESQL)
# ============================================================================
# ATENÇÃO À VARIÁVEL 'DB_HOST':
# 
# -> Use 'localhost': Se você for rodar os scripts Python diretamente no 
#    terminal do seu computador (PowerShell/CMD), para conectar no postgres localmente.
# 
# -> Use 'postgres': Se você for rodar os scripts DE DENTRO dos containers 
#    Docker (ex: via DAGs do Airflow ou comandos como 'docker exec').
# ============================================================================
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=airflow
DB_NAME=prf_dw

# ============================================================================
# 2. CONFIGURAÇÕES DO ORQUESTRADOR (APACHE AIRFLOW)
# ============================================================================
# Credenciais para acessar a interface web do Airflow (http://localhost:8080)
# ============================================================================
AIRFLOW_USER=admin
AIRFLOW_PASSWORD=admin
# AIRFLOW__WEBSERVER__SECRET_KEY=sua_chave_secreta_aqui